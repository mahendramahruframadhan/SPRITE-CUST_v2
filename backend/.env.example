# Server
PORT=5005
BETTER_AUTH_SECRET=change-this-to-32-char-random-secret
BETTER_AUTH_URL=http://localhost:5005

# Database — Postgres Docker (db lain aman, beda database di server yang sama)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/sprite_cust

# Google Sheets — same doc as frontend SheetConfigPage.jsx:67
SHEET_ID=1dJKS7iJ80iK2rV5Jd9D6ap3yATcaUOlj07IcJg74CuY
SHEET_GID_DATA=1535609154
SHEET_GID_CONFIG=0
# Service Account JSON base64 (optional). If empty, backend uses mock from frontend/src/data/cases.js
GOOGLE_SERVICE_ACCOUNT_JSON=

# Frontend CORS
FRONTEND_URL=http://localhost:5173

# Sheets mock mode auto if GOOGLE_SERVICE_ACCOUNT_JSON empty
SHEETS_MOCK=true
