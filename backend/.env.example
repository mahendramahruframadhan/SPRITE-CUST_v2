# ============================================================
# SPRITE-CUST Backend — contoh konfigurasi localhost
# Cara pakai: cp .env.example .env   (atau: npm run setup)
# Lalu:       npm install && npm run dev
# ============================================================

# --- Server ---
PORT=5005
BETTER_AUTH_SECRET=change-this-to-32-char-random-secret
BETTER_AUTH_URL=http://localhost:5005

# --- Database: pilih SALAH SATU mode ---
#
# MODE A (default, tanpa Docker — langsung jalan):
#   Kosongkan DATABASE_URL agar backend memakai pg-mem (in-memory).
#   Cocok untuk lanjutkan development di localhost. Data hilang saat restart.
DATABASE_URL=
#
# MODE B (persist + data tidak hilang, butuh Postgres):
#   Jalankan Postgres dulu (mis. Docker), lalu odkomentari baris ini:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5433/sprite_cust
#
# Aturan kode (src/db/drizzle.service.ts):
#   url diawali "postgres" → pakai Postgres asli, selain itu → pg-mem.

# --- Google Sheets (opsional) ---
# Sheet live terbaru — struktur/kolom sama dengan sheet lama
# Lama: 1dJKS7iJ80iK2rV5Jd9D6ap3yATcaUOlj07IcJg74CuY
SHEET_ID=1dozgmtHZFsIkwbnFbsDR5hCQWc6_LG_psPzIXyFX8XU
SHEET_GID_DATA=1535609154
SHEET_GID_CONFIG=0
# Nama tab data (opsional). Kosongkan = coba tab 'Data', lalu tab pertama.
# Contoh bila data di tab lain: SHEET_DATA_TAB=Data September
SHEET_DATA_TAB=
# Service Account JSON base64 (opsional). Kosong = backend pakai mock dari frontend/src/data/cases.js
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- Frontend (CORS) ---
FRONTEND_URL=http://localhost:5173

# --- Sheets mock ---
# true = tanpa Google API (default enak untuk localhost)
# false = baca/tulis Sheet asli (wajib isi GOOGLE_SERVICE_ACCOUNT_JSON + share sheet sebagai Editor)
SHEETS_MOCK=true

# --- PDF invoice (S3-compatible: Cloudflare R2 / Supabase Storage, server saja) ---
# Kosong = endpoint PDF nonaktif (R2_NOT_CONFIGURED). Isi untuk mengaktifkan.
# R2 (Cloudflare): R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# Supabase: R2_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3 + R2_REGION=<region project, mis. ap-southeast-1>
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=pdf-storage
# R2_REGION=auto (R2) atau region project (Supabase)
# R2_MAX_MB=10 (batas per file, selaras validasi tombol frontend)
# PDF_STUCK_MINUTES=30 (bersihkan upload macet via cron 10 menit)
