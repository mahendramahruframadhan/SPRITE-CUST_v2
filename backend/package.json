{
  "name": "sprite-cust-backend",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=18 <25",
    "npm": ">=9"
  },
  "scripts": {
    "dev": "ts-node --transpile-only src/main.ts",
    "dev:local": "cross-env DATABASE_URL= ts-node --transpile-only src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node -r ts-node/register/transpile-only --test \"test/**/*.test.ts\"",
    "setup": "node -e \"const fs=require('fs');if(!fs.existsSync('.env')){fs.copyFileSync('.env.example','.env');console.log('.env dibuat dari .env.example')}else{console.log('.env sudah ada, tidak ditimpa')}\"",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:empty": "psql \"$DATABASE_URL\" -f ./scripts/reset-db.sql",
    "dev:empty": "cross-env SKIP_SEED=true ts-node --transpile-only src/main.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1136.0",
    "@aws-sdk/s3-request-presigner": "^3.1136.0",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/schedule": "^4.1.2",
    "better-auth": "^1.3.8",
    "drizzle-orm": "^0.38.3",
    "googleapis": "^144.0.0",
    "pg": "^8.13.1",
    "pg-mem": "^3.0.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.19",
    "@types/pg": "^8.11.11",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.30.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
